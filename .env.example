# Copy to .env.local and fill in. .env.local is git-ignored: never commit it.
# On Vercel, add the same names under Project -> Settings -> Environment Variables, then redeploy.

# Supabase -> Project Settings -> API. The service-role key is server-only; never expose it to the browser.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Gemini: use a key from a project with BILLING ENABLED. Free-tier inputs may be used to train Google's models.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash

# Resend
RESEND_API_KEY=
RESEND_FROM=Kargo Hiring <onboarding@resend.dev>
# Free tier without a verified domain can only send to your own Resend account email.
# While this is set, every email goes to this test inbox instead of the candidate.
RESEND_TEST_TO=

